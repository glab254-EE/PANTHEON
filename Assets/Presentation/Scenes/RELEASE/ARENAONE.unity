          m_BoolArgument: 0
        m_CallState: 2
  sequence:
  - invoker: {fileID: 1583896053}
    text: I know you - the masked man, or you're not a human being, arent't you?
      You came for answers?
    autoContinue: 0
    autoContinueDelay: 0
  - invoker: {fileID: 1275068921}
    text: 'Who are you? Where are the other people? Are they dead? And why my world
      is full of monsters? '
    autoContinue: 0
    autoContinueDelay: 0
  - invoker: {fileID: 1583896053}
    text: ' It''s been 100 years since you''ve defeated Cerberus in front of the
      Hell Gates. '
    autoContinue: 0
    autoContinueDelay: 0
  - invoker: {fileID: 1275068921}
    text: What God? Is there any possibility to save my home? Where are my Gods?
    autoContinue: 0
    autoContinueDelay: 0
  - invoker: {fileID: 1583896053}
    text: 'Your home and your family is no more. He destroyed everything. I don''t
      know what you''re searching for. '
    autoContinue: 0
    autoContinueDelay: 0
  - invoker: {fileID: 1275068921}
    text: 'I will hunt him down and kill. Even if my world is doomed, there''s still
      an opportunity to find '
    autoContinue: 0
    autoContinueDelay: 0
  - invoker: {fileID: 1583896053}
    text: 'No man is capable of killing the God, but you''re not a man, at least
      half of you. You must obtain the divine power toi be able to fight the one, '
    autoContinue: 0
    autoContinueDelay: 0
  - invoker: {fileID: 1275068921}
    text: What if I won't be able to kill the guard? Do you know how to leave this
      island, old man?
    autoContinue: 0
    autoContinueDelay: 0
  - invoker: {fileID: 1583896053}
    text: I know, and I have something for you. Kill all monsters on this island,
      except the guard in the Temple, and come to me, bring me their Will, and I'll
      help you.
    autoContinue: 0
    autoContinueDelay: 0
  SkipTrigger: 0
