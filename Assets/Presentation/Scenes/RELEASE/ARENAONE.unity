          m_FloatArgument: 0
          m_StringArgument: Talk
          m_BoolArgument: 1
        m_CallState: 2
      - m_Target: {fileID: 1583896050}
        m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
        m_MethodName: SetActive
        m_Mode: 6
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
